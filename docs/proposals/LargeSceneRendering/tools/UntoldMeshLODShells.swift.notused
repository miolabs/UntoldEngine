import Foundation
import simd

/// Finds the meshes of a model that are layered a short way behind another, and the
/// deviation each may be allowed so that the two keep their distance.
///
/// Every mesh of a model is simplified on its own, within the deviation of one triangle of
/// the level. A car's door panel runs a centimetre or two behind its door, and once the
/// allowance exceeds half that gap the panel comes through the paint at the coarse levels.
/// A mesh is layered with another when most of its surface lies close to the other and
/// faces the same way, as a panel behind a door, a headliner under a roof or one shell
/// inside another do; then both are held to a share of the gap between them. Parts that
/// merely touch (a post on a plane, a frame around a pane) have only a few points close to
/// the other, and those meet it edge on.
enum UntoldMeshLODShells {
    /// How close to another mesh a point has to be, as a share of the model's diameter, to
    /// count as near it.
    static let nearShare: Float = 0.02
    /// The share of a mesh's sampled points that must be near the other and face along
    /// its surface for the mesh to be layered with it.
    static let shellShare: Float = 0.7
    /// How nearly the two surfaces must face the same way at a near point: the cosine of
    /// the angle between their normals, either way round.
    static let facingShare: Float = 0.7
    /// The share of the gap between two layered meshes each may deviate by: together they
    /// keep a fifth of it.
    static let gapShare: Float = 0.4
    /// The least allowance a layered mesh keeps, as a share of the model's diameter, so
    /// that two surfaces that already touch do not freeze their triangles.
    static let floorShare: Float = 0.0005
    /// How many points of a mesh are measured against another.
    static let sampleCount = 256

    /// For each mesh, the largest deviation (model units) its levels may have so that it
    /// keeps its distance from the meshes it is layered with; nil for a mesh that is in no
    /// such pair. `transforms` take each mesh to model space. An aggregate of loose pieces
    /// (a canopy) is never layered with anything: its cards face every way.
    static func caps(meshes: [UntoldLODMesh], parts: [UntoldLODMeshParts], transforms: [simd_float4x4], diameter: Float) -> [Float?] {
        var caps = [Float?](repeating: nil, count: meshes.count)
        guard meshes.count > 1, diameter > 0 else { return caps }
        let near = diameter * nearShare
        let floor = diameter * floorShare

        let bounds = meshes.indices.map { index -> (lower: SIMD3<Float>, upper: SIMD3<Float>)? in
            let mesh = meshes[index]
            guard mesh.vertexCount > 0, mesh.triangleCount > 0, parts[index].clutterIndices.isEmpty else { return nil }
            return modelSpaceBounds(of: mesh, transform: transforms[index])
        }
        var grids = [TriangleGrid?](repeating: nil, count: meshes.count)
        func grid(_ index: Int) -> TriangleGrid {
            if let grid = grids[index] { return grid }
            let grid = TriangleGrid(mesh: meshes[index], transform: transforms[index], cellSize: near)
            grids[index] = grid
            return grid
        }

        for first in meshes.indices {
            guard let firstBounds = bounds[first] else { continue }
            let samples = samplePoints(of: meshes[first], transform: transforms[first])
            guard !samples.isEmpty else { continue }
            for second in meshes.indices where second != first {
                guard let secondBounds = bounds[second],
                      overlap(firstBounds, secondBounds, margin: near)
                else { continue }
                let other = grid(second)
                var gaps: [Float] = []
                gaps.reserveCapacity(samples.count)
                for sample in samples {
                    guard let nearest = other.nearest(to: sample.point, within: near),
                          abs(simd_dot(nearest.normal, sample.normal)) >= facingShare
                    else { continue }
                    gaps.append(nearest.distance)
                }
                guard Float(gaps.count) >= Float(samples.count) * shellShare else { continue }
                gaps.sort()
                // The lower quarter of the gaps: where the two come closest over a good
                // part of their surface.
                let gap = gaps[gaps.count / 4]
                let cap = max(gap * gapShare, floor)
                caps[first] = min(caps[first] ?? cap, cap)
                caps[second] = min(caps[second] ?? cap, cap)
            }
        }
        return caps
    }

    // MARK: - Points and bounds

    /// A point of a mesh's surface in model space, with the surface's normal there.
    struct SurfacePoint {
        var point: SIMD3<Float>
        var normal: SIMD3<Float>
    }

    /// Up to `sampleCount` distinct points of the mesh's surface, in model space, spread
    /// evenly over its vertices.
    static func samplePoints(of mesh: UntoldLODMesh, transform: simd_float4x4) -> [SurfacePoint] {
        var distinct: [Int] = []
        distinct.reserveCapacity(mesh.vertexCount)
        for vertex in 0 ..< mesh.vertexCount where Int(mesh.positionRemap[vertex]) == vertex {
            distinct.append(vertex)
        }
        guard !distinct.isEmpty else { return [] }
        let rotation = normalTransform(of: transform)
        let stride = max(distinct.count / sampleCount, 1)
        var points: [SurfacePoint] = []
        points.reserveCapacity(min(distinct.count, sampleCount + 1))
        var index = 0
        while index < distinct.count, points.count < sampleCount {
            let vertex = distinct[index]
            let normal = SIMD3<Float>(mesh.normals[vertex * 3], mesh.normals[vertex * 3 + 1], mesh.normals[vertex * 3 + 2])
            points.append(SurfacePoint(
                point: simd_make_float3(simd_mul(transform, SIMD4<Float>(mesh.position(vertex), 1))),
                normal: simd_normalize(simd_mul(rotation, normal))
            ))
            index += stride
        }
        return points
    }

    /// What takes a normal of the mesh to model space: the inverse transpose of the
    /// transform's upper 3x3 (the transform itself for a rotation and a uniform scale).
    static func normalTransform(of transform: simd_float4x4) -> simd_float3x3 {
        let upper = simd_float3x3(
            simd_make_float3(transform.columns.0),
            simd_make_float3(transform.columns.1),
            simd_make_float3(transform.columns.2)
        )
        let inverse = upper.inverse
        return inverse.determinant.isFinite && inverse.determinant != 0 ? inverse.transpose : upper
    }

    private static func modelSpaceBounds(of mesh: UntoldLODMesh, transform: simd_float4x4) -> (lower: SIMD3<Float>, upper: SIMD3<Float>) {
        var lower = SIMD3<Float>(repeating: .greatestFiniteMagnitude)
        var upper = SIMD3<Float>(repeating: -.greatestFiniteMagnitude)
        for corner in 0 ..< 8 {
            let point = SIMD4<Float>(
                corner & 1 == 0 ? mesh.boundsMin.x : mesh.boundsMax.x,
                corner & 2 == 0 ? mesh.boundsMin.y : mesh.boundsMax.y,
                corner & 4 == 0 ? mesh.boundsMin.z : mesh.boundsMax.z,
                1
            )
            let moved = simd_make_float3(simd_mul(transform, point))
            lower = simd_min(lower, moved)
            upper = simd_max(upper, moved)
        }
        return (lower, upper)
    }

    private static func overlap(
        _ a: (lower: SIMD3<Float>, upper: SIMD3<Float>),
        _ b: (lower: SIMD3<Float>, upper: SIMD3<Float>),
        margin: Float
    ) -> Bool {
        all(a.lower - margin .<= b.upper) && all(b.lower - margin .<= a.upper)
    }

    // MARK: - A mesh's triangles on a grid

    /// The triangles of one mesh in model space, binned on a uniform grid so that the
    /// triangles near a point, or along a line, are found without a pass over them all.
    struct TriangleGrid {
        private let vertices: [SIMD3<Float>]
        private let triangles: [SIMD3<UInt32>]
        private let origin: SIMD3<Float>
        private let cellSize: Float
        private let cells: SIMD3<Int>
        /// The triangles of each cell, as offsets into `cellTriangles`.
        private let cellStart: [Int]
        private let cellTriangles: [Int32]

        init(mesh: UntoldLODMesh, transform: simd_float4x4, cellSize: Float) {
            var moved = [SIMD3<Float>](repeating: .zero, count: mesh.vertexCount)
            var lower = SIMD3<Float>(repeating: .greatestFiniteMagnitude)
            var upper = SIMD3<Float>(repeating: -.greatestFiniteMagnitude)
            for vertex in 0 ..< mesh.vertexCount {
                let point = simd_make_float3(simd_mul(transform, SIMD4<Float>(mesh.position(vertex), 1)))
                moved[vertex] = point
                lower = simd_min(lower, point)
                upper = simd_max(upper, point)
            }
            var corners: [SIMD3<UInt32>] = []
            corners.reserveCapacity(mesh.triangleCount)
            for triangle in 0 ..< mesh.triangleCount {
                corners.append(SIMD3<UInt32>(mesh.indices[triangle * 3], mesh.indices[triangle * 3 + 1], mesh.indices[triangle * 3 + 2]))
            }
            let size = max(cellSize, 1e-6)
            // One cell of margin all round, so that a point just outside the mesh is in the grid.
            let gridOrigin = lower - size
            let extent = upper - lower + 2 * size
            let counts = SIMD3<Int>(
                min(max(Int((extent.x / size).rounded(.up)), 1), 128),
                min(max(Int((extent.y / size).rounded(.up)), 1), 128),
                min(max(Int((extent.z / size).rounded(.up)), 1), 128)
            )
            // The cells are at least `size`; larger when the mesh needs more than 128 of
            // them along an axis.
            let step = SIMD3<Float>(extent.x / Float(counts.x), extent.y / Float(counts.y), extent.z / Float(counts.z))
            let cellCount = counts.x * counts.y * counts.z
            func range(_ lo: SIMD3<Float>, _ hi: SIMD3<Float>) -> (SIMD3<Int>, SIMD3<Int>) {
                let a = (lo - gridOrigin) / step
                let b = (hi - gridOrigin) / step
                let first = SIMD3<Int>(
                    min(max(Int(a.x), 0), counts.x - 1), min(max(Int(a.y), 0), counts.y - 1), min(max(Int(a.z), 0), counts.z - 1)
                )
                let last = SIMD3<Int>(
                    min(max(Int(b.x), 0), counts.x - 1), min(max(Int(b.y), 0), counts.y - 1), min(max(Int(b.z), 0), counts.z - 1)
                )
                return (first, last)
            }
            var perCell = [Int32](repeating: 0, count: cellCount)
            var ranges: [(SIMD3<Int>, SIMD3<Int>)] = []
            ranges.reserveCapacity(corners.count)
            for triangle in corners {
                let a = moved[Int(triangle.x)], b = moved[Int(triangle.y)], c = moved[Int(triangle.z)]
                let r = range(simd_min(simd_min(a, b), c), simd_max(simd_max(a, b), c))
                ranges.append(r)
                for z in r.0.z ... r.1.z {
                    for y in r.0.y ... r.1.y {
                        for x in r.0.x ... r.1.x {
                            perCell[(z * counts.y + y) * counts.x + x] += 1
                        }
                    }
                }
            }
            var start = [Int](repeating: 0, count: cellCount + 1)
            for cell in 0 ..< cellCount {
                start[cell + 1] = start[cell] + Int(perCell[cell])
            }
            var fill = start
            var binned = [Int32](repeating: 0, count: start[cellCount])
            for (index, r) in ranges.enumerated() {
                for z in r.0.z ... r.1.z {
                    for y in r.0.y ... r.1.y {
                        for x in r.0.x ... r.1.x {
                            let cell = (z * counts.y + y) * counts.x + x
                            binned[fill[cell]] = Int32(index)
                            fill[cell] += 1
                        }
                    }
                }
            }
            vertices = moved
            triangles = corners
            origin = gridOrigin
            self.cellSize = size
            cells = counts
            cellStart = start
            cellTriangles = binned
            cellStep = step
        }

        private let cellStep: SIMD3<Float>

        private func cell(of point: SIMD3<Float>) -> SIMD3<Int>? {
            let p = (point - origin) / cellStep
            guard p.x >= 0, p.y >= 0, p.z >= 0 else { return nil }
            let c = SIMD3<Int>(Int(p.x), Int(p.y), Int(p.z))
            guard c.x < cells.x, c.y < cells.y, c.z < cells.z else { return nil }
            return c
        }

        private func triangles(in cell: SIMD3<Int>) -> ArraySlice<Int32> {
            let index = (cell.z * cells.y + cell.y) * cells.x + cell.x
            return cellTriangles[cellStart[index] ..< cellStart[index + 1]]
        }

        /// The nearest triangle to `point` within `limit`: its distance and the way its
        /// face points.
        func nearest(to point: SIMD3<Float>, within limit: Float) -> (distance: Float, normal: SIMD3<Float>)? {
            guard let home = cell(of: point) else { return nil }
            // The cells within `limit` of the point: a step of cells each way, since the
            // cells are at least `limit` wide.
            var best = limit
            var bestTriangle = -1
            var seen = Set<Int32>()
            for z in max(home.z - 1, 0) ... min(home.z + 1, cells.z - 1) {
                for y in max(home.y - 1, 0) ... min(home.y + 1, cells.y - 1) {
                    for x in max(home.x - 1, 0) ... min(home.x + 1, cells.x - 1) {
                        for index in triangles(in: SIMD3<Int>(x, y, z)) where seen.insert(index).inserted {
                            let t = triangles[Int(index)]
                            let d = Self.distance(from: point, toTriangle: vertices[Int(t.x)], vertices[Int(t.y)], vertices[Int(t.z)])
                            if d <= best {
                                best = d
                                bestTriangle = Int(index)
                            }
                        }
                    }
                }
            }
            guard bestTriangle >= 0 else { return nil }
            let t = triangles[bestTriangle]
            let a = vertices[Int(t.x)], b = vertices[Int(t.y)], c = vertices[Int(t.z)]
            let cross = simd_cross(b - a, c - a)
            let length = simd_length(cross)
            return (best, length > 0 ? cross / length : SIMD3<Float>(0, 1, 0))
        }

        /// The distance from `p` to the triangle `a b c`.
        private static func distance(from p: SIMD3<Float>, toTriangle a: SIMD3<Float>, _ b: SIMD3<Float>, _ c: SIMD3<Float>) -> Float {
            // Ericson, Real-Time Collision Detection, closest point on a triangle.
            let ab = b - a, ac = c - a, ap = p - a
            let d1 = simd_dot(ab, ap), d2 = simd_dot(ac, ap)
            if d1 <= 0, d2 <= 0 { return simd_length(ap) }
            let bp = p - b
            let d3 = simd_dot(ab, bp), d4 = simd_dot(ac, bp)
            if d3 >= 0, d4 <= d3 { return simd_length(bp) }
            let vc = d1 * d4 - d3 * d2
            if vc <= 0, d1 >= 0, d3 <= 0 {
                let v = d1 / (d1 - d3)
                return simd_length(p - (a + v * ab))
            }
            let cp = p - c
            let d5 = simd_dot(ab, cp), d6 = simd_dot(ac, cp)
            if d6 >= 0, d5 <= d6 { return simd_length(cp) }
            let vb = d5 * d2 - d1 * d6
            if vb <= 0, d2 >= 0, d6 <= 0 {
                let w = d2 / (d2 - d6)
                return simd_length(p - (a + w * ac))
            }
            let va = d3 * d6 - d5 * d4
            if va <= 0, d4 - d3 >= 0, d5 - d6 >= 0 {
                let w = (d4 - d3) / ((d4 - d3) + (d5 - d6))
                return simd_length(p - (b + w * (c - b)))
            }
            let denominator = 1 / (va + vb + vc)
            let v = vb * denominator, w = vc * denominator
            return simd_length(p - (a + ab * v + ac * w))
        }
    }
}
